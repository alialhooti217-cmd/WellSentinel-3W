{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python.analysis.extraPaths": [
      "${workspaceFolder}/src"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
      "tests"
    ],
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder}\\src"
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true
    },
    "search.exclude": {
      "data/**": true
    },
    "files.watcherExclude": {
      "data/**": true
    },
    "editor.rulers": [
      110
    ],
    "[python]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "charliermarsh.ruff"
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug: build features (quick, 3 per class)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/02_build_features.py",
        "args": [
          "--limit",
          "3"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Debug: train baseline",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/03_train_baseline.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Debug: Streamlit dashboard",
        "type": "debugpy",
        "request": "launch",
        "module": "streamlit",
        "args": [
          "run",
          "app/streamlit_app.py"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Debug: current file",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "0. Setup environment (first time)",
        "type": "shell",
        "command": "powershell -ExecutionPolicy Bypass -File setup_env.ps1",
        "problemMatcher": []
      },
      {
        "label": "1. Download / resume 3W data",
        "type": "shell",
        "command": ".venv\\Scripts\\python scripts/00_download_data.py",
        "problemMatcher": []
      },
      {
        "label": "2. Build inventory + folds",
        "type": "shell",
        "command": ".venv\\Scripts\\python scripts/01_build_inventory.py",
        "problemMatcher": []
      },
      {
        "label": "3. Build features",
        "type": "shell",
        "command": ".venv\\Scripts\\python scripts/02_build_features.py",
        "problemMatcher": []
      },
      {
        "label": "4. Train + evaluate baseline",
        "type": "shell",
        "command": ".venv\\Scripts\\python scripts/03_train_baseline.py",
        "problemMatcher": []
      },
      {
        "label": "5. Run dashboard",
        "type": "shell",
        "command": ".venv\\Scripts\\streamlit run app/streamlit_app.py",
        "problemMatcher": []
      },
      {
        "label": "Run tests",
        "type": "shell",
        "command": ".venv\\Scripts\\pytest -q",
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Full pipeline (2 → 4)",
        "dependsOrder": "sequence",
        "dependsOn": [
          "2. Build inventory + folds",
          "3. Build features",
          "4. Train + evaluate baseline"
        ],
        "problemMatcher": []
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-toolsai.jupyter",
      "ms-toolsai.datawrangler",
      "charliermarsh.ruff",
      "yzhang.markdown-all-in-one",
      "mhutchie.git-graph"
    ]
  }
}